# ==============================================================================
# FIELD ASSISTANT (MINISTÉRIO PESSOAL) — CONFIGURAÇÃO DE AMBIENTE HOMOLOGAÇÃO
# ==============================================================================
# INSTRUÇÕES DE USO:
# 1. Copie este arquivo para o ambiente de testes/QA: cp .env.homolog.example .env.homolog
# 2. Preencha com as credenciais do projeto Supabase de homologação/staging.
# 3. O arquivo '.env.homolog' está protegido pelo .gitignore (.env*).
# 4. HTTPS é OBRIGATÓRIO para a URL em homologação.
# 5. NUNCA insira credenciais com privilégio 'service_role'.
#
# COMO COMPILAR / EXECUTAR:
# - Flutter Web:
#     flutter run -d chrome --dart-define-from-file=.env.homolog
# - Build Web Release:
#     flutter build web --release --dart-define-from-file=.env.homolog
# - Build iOS:
#     flutter build ios --release --no-codesign --dart-define-from-file=.env.homolog
# ==============================================================================

APP_ENV=homolog
SUPABASE_URL=https://your-homolog-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-here-homolog.signature
