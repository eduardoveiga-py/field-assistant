# ==============================================================================
# FIELD ASSISTANT (MINISTÉRIO PESSOAL) — CONFIGURAÇÃO DE AMBIENTE LOCAL / DEV
# ==============================================================================
# INSTRUÇÕES DE USO:
# 1. Copie este arquivo para um arquivo real local: cp .env.example .env
# 2. Preencha as variáveis com os dados do seu projeto Supabase local ou de desenvolvimento.
# 3. O arquivo '.env' está incluído no .gitignore e NUNCA deve ser commitado no Git.
# 4. NUNCA utilize a chave 'service_role' (Service Secret). Utilize EXCLUSIVAMENTE a chave 'anon'.
#
# COMO COMPILAR / EXECUTAR COM ESTE ARQUIVO:
# - Flutter Web:
#     .\scripts\run_web.ps1 -EnvFile .env
#     ou: flutter run -d chrome --dart-define-from-file=.env
# - Testes / Mobile:
#     flutter run --dart-define-from-file=.env
# ==============================================================================

# Identificador do ambiente: dev | homolog | prod
APP_ENV=dev

# URL do endpoint HTTP/HTTPS do Supabase (para ambiente local Docker: http://127.0.0.1:54321)
SUPABASE_URL=https://your-dev-project-id.supabase.co

# Chave anônima pública do Supabase (NUNCA utilize a chave service_role)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-here-dev.signature
